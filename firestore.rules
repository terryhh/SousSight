rules_version = '2';

// Instructor identity comes ONLY from this admin-deployed map (mirrors
// demoInstructorEmails in lib/core/fakes.dart), so roles are never
// self-assigned from a client. Learners are any other signed-in user,
// including anonymous.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', ''); }
    function instructorId() {
      return {
        'ana@soussight.demo': 'ana',
        'marcus@soussight.demo': 'marcus',
        'priya@soussight.demo': 'priya',
        'coordinator@soussight.demo': 'coordinator'
      }.get(email(), null);
    }
    function isInstructor() { return signedIn() && instructorId() != null; }
    function isCoordinator() { return isInstructor() && instructorId() == 'coordinator'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /recipes/{recipeId} {
      allow read: if signedIn();
      allow create, delete: if isCoordinator();
      // Knowledge loop: instructors may only append reviewed substitutions.
      allow update: if isCoordinator()
        || (isInstructor() && changed().hasOnly(['reviewedSubstitutions']));
    }

    match /instructors/{id} {
      allow read: if signedIn();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator()
        || (isInstructor() && instructorId() == id && changed().hasOnly(['available']));
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isCoordinator();
    }

    // Phone numbers for Vonage: admin console / Functions only.
    match /instructorContacts/{id} { allow read, write: if false; }
    match /learnerContacts/{id} { allow read, write: if false; }

    match /sessions/{sessionId} {
      allow read, update, delete: if signedIn() && resource.data.learnerId == request.auth.uid
        || isCoordinator();
      allow create: if signedIn() && request.resource.data.learnerId == request.auth.uid;

      match /checkpoints/{cpId} {
        function sessionOwner() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.learnerId;
        }
        allow read, write: if signedIn() && sessionOwner() == request.auth.uid;
        allow delete: if isCoordinator();
      }
    }

    match /requests/{requestId} {
      function isRequester() { return signedIn() && resource.data.learnerId == request.auth.uid; }

      allow read: if isRequester() || isInstructor();
      allow create: if signedIn()
        && request.resource.data.learnerId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && !('notify' in request.resource.data);
      allow delete: if isCoordinator();

      // Clients never write `notify` (Cloud Functions do), and nothing moves
      // back to 'submitted' (protects idempotent retries).
      allow update: if !('notify' in changed())
        && request.resource.data.status != 'submitted'
        && (
          // Learner: triage/routing of their own submitted request, resolve,
          // still stuck, cancel, add details.
          (isRequester()
            && request.resource.data.learnerId == resource.data.learnerId
            && (resource.data.status == 'submitted'
                || request.resource.data.status in ['resolved', 'accepted', 'cancelled']
                || request.resource.data.status == resource.data.status))
          // Instructors: accept, decline, answer, assign, reroute, approve.
          || isInstructor()
        );
    }
  }
}
